# 실제 값은 .env 에만 넣는다 (.env 는 gitignore 됨)

# 로그인이 필요한 페이지용 쿠키 문자열 (예: "k1=v1; k2=v2"). 없으면 비로그인 수집.
CRAWLER_COOKIES=

# 프록시 서버 (예: http://user:pass@host:port). 없으면 직접 연결.
CRAWLER_PROXY=

# SQLite DB 경로 (기본값: data/crawler.db)
CRAWLER_DB=

# 요청 간 지연 범위(초). 기본 3~8초.
CRAWLER_DELAY_MIN=
CRAWLER_DELAY_MAX=
