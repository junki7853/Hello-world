# 실제 값은 .env 에만 넣는다 (.env·쿠키파일·storage_state 는 gitignore 됨)
# 형식만 참고하고 값은 더미다. 설정 절차는 SETUP-COOKIES.md 참고.

# --- 프록시 (중국 지역 IP 필요 플랫폼용) -------------------------------------
# 형식: http://host:port  또는 인증 포함 http://user:pass@host:port
CRAWLER_PROXY=
# 인증을 URL 에 넣지 않을 때 별도 지정 (지정 시 URL 임베드보다 우선)
CRAWLER_PROXY_USERNAME=
CRAWLER_PROXY_PASSWORD=

# --- 쿠키 (로그인월/지역차단 플랫폼용) ---------------------------------------
# 우선순위(높은 것부터):
#   1) CRAWLER_COOKIES_<PLATFORM>            플랫폼별 쿠키 헤더 문자열
#   2) $CRAWLER_COOKIES_DIR/<platform>.json  Playwright storage_state (쿠키+localStorage)
#   3) $CRAWLER_COOKIES_DIR/<platform>.txt   플랫폼별 쿠키 헤더 문자열
#   4) CRAWLER_COOKIES                        전역 쿠키 헤더 문자열 (하위호환)
# 플랫폼명: xiaohongshu / dianping / douyin / ctrip / mafengwo

# 전역 쿠키 헤더 (플랫폼별 설정이 없을 때 폴백). 예: "k1=v1; k2=v2"
CRAWLER_COOKIES=

# 플랫폼별 쿠키 헤더 (전역보다 우선). 필요한 플랫폼만 채운다.
CRAWLER_COOKIES_XIAOHONGSHU=
CRAWLER_COOKIES_DIANPING=

# 쿠키 파일 디렉터리. 여기에 <platform>.json(storage_state) 또는 <platform>.txt(헤더)를 둔다.
# 예: ./cookies  (cookies/ 는 gitignore 됨)
CRAWLER_COOKIES_DIR=

# --- 기타 -------------------------------------------------------------------
# SQLite DB 경로 (기본값: data/crawler.db)
CRAWLER_DB=

# 요청 간 지연 범위(초). 기본 3~8초.
CRAWLER_DELAY_MIN=
CRAWLER_DELAY_MAX=
